; Cardboard Cockpit — native desktop application
config_version=5

[application]
config/name="Cardboard Cockpit"
config/description="SPECTRE X-26. One airframe. Control the sky."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/size/resizable=true
window/size/mode=2

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.macos="metal"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=false
scaling_3d/fsr_sharpness=0.25
scaling_3d/mode=2
scaling_3d/scale=0.67
textures/default_filters/anisotropic_filtering_level=4
mesh_lod/lod_change/threshold_pixels=1.0
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.12, 0.18, 0.24, 1)

[audio]
general/text_to_speech=true
driver/enable_input=false

[physics]
common/physics_ticks_per_second=60
